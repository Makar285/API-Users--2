<h2>Update User</h2>
<form action="/users/previously/update" method="POST">
  <label for="id">Id: </label>
  <input type="number" placeholder="Enter id user for update" id="id" name="id">
  <br>
  <label for="name">Name: </label>
  <input type="text" placeholder="Enter new name user" id="name" name="name">
  <br>
  <label for="age">Age: </label>
  <input type="number" placeholder="Enter new age user" id="age" name="age">
  <br>
  <label for="isDelete">IsDelete: </label>
  <select id="isDelete" name="isDelete">
    <option value="false">False</option>
    <option value="true">True</option>
  </select>
  <br>
  <button type="submit">Submit</button>
</form>