<h2>Get All Users</h2>
{{#if lengthUsersArrayPositive}}
  <ul>
    {{#each users}}
      <li>{{#if (lengthNameMore this.name 5)}}Long{{else}}Short{{/if}}, Id: {{this.id}}, name: {{this.name}}, age: {{this.age}}, isDelete: {{this.isDelete}}</li>
    {{/each}}
  </ul>
{{else}}
  <h3>No Users</h3>
{{/if}}